# =========================================================================
# Omo Iya Exchange — Environment Variables Configuration
# Copy this file to '.env' and fill in your custom values.
# =========================================================================

# Database Connection (Neon PostgreSQL free-tier URL)
# Example: postgresql://username:password@ep-cool-waterfall-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/omoiya_db?sslmode=require"

# Express Backend Server Settings
PORT=5000
NODE_ENV="development"

# Next.js Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:3000"

# Authentication Security Settings (JWT)
JWT_SECRET="omoiya-exchange-super-secret-development-key-change-this"
JWT_REFRESH_SECRET="omoiya-exchange-refresh-secret-development-key-change-this"

# Paystack API Keys (Nigeria Payment Gateway - Test Mode is FREE)
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email Dispatch Configurations (Resend Free Tier or SMTP)
# Resend API Key (Optional: Falls back to local console logger if missing)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Alternative custom SMTP settings:
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="Omo Iya Exchange <noreply@omoiyaexchange.com>"
